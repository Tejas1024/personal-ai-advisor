{
  "family": "personal-ai-advisor",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::339712706837:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "personal-ai-advisor",
      "image": "339712706837.dkr.ecr.ap-south-1.amazonaws.com/personal-ai-advisor:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8501,
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/personal-ai-advisor",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
